{
  "$schema": "https://opencode.ai/config.json",
  "model": "meta/llama-3.3-70b-instruct",
  "mcp": {
    "olist-lakehouse": {
      "type": "remote",
      "url": "https://olist-mcp.vercel.app/api/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:MCP_API_KEY}"
      }
    },
    "olist-local": {
      "type": "remote",
      "url": "http://localhost:3000/api/mcp",
      "enabled": false,
      "headers": {
        "Authorization": "Bearer {env:MCP_API_KEY}"
      }
    }
  }
}
